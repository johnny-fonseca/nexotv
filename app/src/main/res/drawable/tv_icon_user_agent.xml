<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de terminal / consola de comandos en estilo outline moderno -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Relleno sutil del cuerpo de la ventana de terminal para dar profundidad -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.15"
        android:pathData="M6,4h12a3,3 0,0 1,3 3v10a3,3 0,0 1,-3 3H6a3,3 0,0 1,-3 -3V7a3,3 0,0 1,3 -3z" />

    <!-- Contorno de la ventana con esquinas redondeadas -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6,4h12a3,3 0,0 1,3 3v10a3,3 0,0 1,-3 3H6a3,3 0,0 1,-3 -3V7a3,3 0,0 1,3 -3z" />

    <!-- Barra de título que separa el encabezado del área de comandos -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.5"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,8.5h18" />

    <!-- Símbolo de prompt (chevron) con vértices suavizados -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7,12.5l3,2.25l-3,2.25" />

    <!-- Línea del cursor de entrada de comandos -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12.5,17h4.5" />

    <!-- Punto de brillo en la barra de título (botón de ventana) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.8"
        android:pathData="M6.25,6.25m-0.75,0a0.75,0.75 0,1 1,1.5 0a0.75,0.75 0,1 1,-1.5 0" />
</vector>
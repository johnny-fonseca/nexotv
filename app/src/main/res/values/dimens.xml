    <dimen name="tv_space_half">12dp</dimen>

    <!-- Escala tipográfica -->
    <dimen name="tv_text_caption">18sp</dimen>
    <dimen name="tv_text_secondary">20sp</dimen>
    <dimen name="tv_text_subtitle">22sp</dimen>
    <dimen name="tv_text_body">24sp</dimen>

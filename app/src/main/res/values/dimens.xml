    <dimen name="tv_component_padding">@dimen/tv_space_2</dimen>

    <dimen name="tv_icon_size">40dp</dimen>


    <!-- Pisos de legibilidad para paneles -->
    <dimen name="tv_panel_text_floor">@dimen/tv_text_secondary</dimen>
    <dimen name="tv_panel_title_floor">@dimen/tv_text_subtitle</dimen>

    <!-- ============================================================
         3. GUÍA (Guide)
         ============================================================ -->
    <dimen name="tv_guide_row_gap">@dimen/tv_space_half</dimen>
    <dimen name="tv_guide_program_image_height">144dp</dimen>

    <!-- Guía: chips de día -->


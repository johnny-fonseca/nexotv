<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta: app/src/main/res/xml/data_extraction_rules.xml -->
<!-- No incluye contenido en la nube ni en transferencias entre dispositivos -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
